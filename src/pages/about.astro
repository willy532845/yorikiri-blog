
---
import Layout from "../layouts/BlogPost.astro";
import config from "@shConfig";
---

<Layout
  title={config.pages.other.about.title}
  description={config.pages.other.about.subTitle}
  pubDate={new Date("2026-11-01")}
  heroImage={config.pages.other.about.heroImage}
  headings={[]}
>
  <div class="mb-16">
    <h2 class="mb-4 text-2xl font-bold">關於我</h2>
    <p class="content-text">
      Yorikiri，平常搞競程和機器人的人類(~~也許不是人類~~)。
    </p>
  </div>

  <div class="mb-16">
    <h2 class="mb-4 text-2xl font-bold">這個網站</h2>
    <p class="content-text">
      題解、研究、開發過程，還有各種奇奇怪怪的數據。
    </p>
  </div>

  <div class="mb-16">
    <h2 class="mb-4 text-2xl font-bold">GitHub</h2>
    <a
      href="https://github.com/willy532845"
      target="_blank"
      rel="noopener noreferrer"
    >
      github.com/willy532845
    </a>
  </div>
</Layout>
